# Copiar a .env y reemplazar los valores de ejemplo.
# Esta variable tiene prioridad sobre las variables DB_* individuales.
DB_CONNECTION_STRING="Server=tcp:your-server.database.windows.net,1433;Database=your_database;User Id=your_user;Password=replace_with_new_password;Encrypt=true;TrustServerCertificate=false;Connection Timeout=30;"

# Alternativa: omitir DB_CONNECTION_STRING y configurar estas variables.
# DB_SERVER=your-server.database.windows.net
# DB_PORT=1433
# DB_NAME=your_database
# DB_USER=your_user
# DB_PASSWORD=replace_with_new_password

EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_RECIPIENTS=
EMAIL_ENABLED=false
# Origen público exacto, sin ruta. En producción usar https://dominio-del-sistema.
# APP_URL=https://your-app.example.com

# Para desarrollo, usar .env.development.example como plantilla independiente.
# EMAIL_ENABLED=false permite desactivar las notificaciones de correo.
