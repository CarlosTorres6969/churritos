# Copiar este archivo a .env.development.local.
# Next.js lo carga automáticamente al ejecutar npm run dev.
# Configurar únicamente una base de pruebas independiente.
# Ejemplo local: Server=tcp:127.0.0.1,1433;Database=ChurritosDev;User Id=churritos_dev;Password=replace_with_dev_password;Encrypt=true;TrustServerCertificate=true;Connection Timeout=5;
# TrustServerCertificate=true es solo para un servidor local con certificado autofirmado.
DEV_DB_CONNECTION_STRING=

# URL HTTPS exacta que genera Ports de VS Code para compartir el puerto 3100.
# Dejar vacía si solo se prueba localmente; no admite comodines.
DEV_APP_URL=

# npm run db:dev genera las contraseñas y las guarda solo en el archivo local.
DEV_ADMIN_USER=admin.dev
DEV_ADMIN_PASSWORD=
DEV_VENDOR_USER=vendedor.dev
DEV_VENDOR_PASSWORD=

# Las pruebas de desarrollo no deben enviar notificaciones reales.
EMAIL_ENABLED=false
EMAIL_USER=
EMAIL_PASSWORD=
